# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=360human
POSTGRES_PASSWORD=changeme
POSTGRES_DB=360human_db

# ─── Redis ────────────────────────────────────────────────
# Local Docker: redis://redis:6379/0
# Upstash (prod): rediss://:password@host:port/0
REDIS_URL=redis://redis:6379/0

# ─── Auth ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# ─── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── External API ─────────────────────────────────────────
ASTROLOGY_API_KEY=your_astrology_api_key
ASTROLOGY_API_BASE_URL=https://astrology-api.io/api/v1

# ─── VietQR / Payment ─────────────────────────────────────
# BANK_BIN: 970436=Vietcombank, 970422=MB Bank, 970415=Vietinbank
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=your_bank_account_number
BANK_ACCOUNT_NAME=360HUMAN
# Generate: openssl rand -hex 16
WEBHOOK_SECRET=change_me_in_production
PRICE_PRO=199000
PRICE_MAX=499000

# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
